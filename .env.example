# =============================================================
# Content Radar — 환경변수 템플릿
# 실제 값은 절대 커밋하지 않는다. GitHub Actions에서는 Secrets로 주입한다.
# 로컬 개발 시 이 파일을 .env로 복사해서 사용한다.
# =============================================================

# --- Supabase ---
# Supabase 프로젝트 대시보드 → Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# service_role 키. Worker/Collector 전용. 절대 프론트엔드에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=
# 프론트엔드(dashboard)용 공개 키 (RLS 적용됨)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Naver Open API (developers.naver.com 애플리케이션 등록) ---
# 사용 API: 검색(뉴스/블로그/카페), 데이터랩 검색어트렌드, 데이터랩 쇼핑인사이트
NAVER_API_CLIENT_ID=
NAVER_API_CLIENT_SECRET=

# --- Naver Search Ads (searchad.naver.com → 도구 → API 사용관리) ---
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# --- YouTube Data API v3 (Google Cloud Console) ---
YOUTUBE_API_KEY=

# --- 공공데이터포털 (data.go.kr) ---
# 정책브리핑(정책뉴스/보도자료) 등 data.go.kr 경유 API 공통 서비스키
DATA_GO_KR_SERVICE_KEY=

# --- 법제처 국가법령정보 공동활용 (open.law.go.kr) ---
# LAW OPEN DATA는 API key가 아니라 신청 시 등록한 OC(기관코드/이메일 ID)를 사용한다.
LAW_API_OC=

# --- Anthropic API (Claude — 클러스터링/Brief/Draft 전용, 점수 계산에는 미사용) ---
ANTHROPIC_API_KEY=

# --- Healthchecks.io ---
# 프로젝트 Ping Key (slug 방식 ping: https://hc-ping.com/<PING_KEY>/<slug>)
HEALTHCHECKS_PING_KEY=
# 워크플로별 slug는 config/healthchecks.yml 참조 (collect-market, collect-policy, ...)
